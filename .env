POSTGRES_USER=postgres
POSTGRES_PASSWORD=pgadmin
POSTGRES_DB=InternshipITexus
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://books-db:${POSTGRES_PORT}/${POSTGRES_DB}

SPRING_CLOUD_CONSUL_HOST=discovery

CONFIG_PORT=8888
SPRING_CONFIG_IMPORT=configserver:http://config-server-app:${CONFIG_PORT}

SPRING_DATA_MONGODB_URI=mongodb://file-db:27017/icons


KAFKA_PORT=9092

KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:${KAFKA_PORT}
ZOOKEEPER_PORT=2181
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:${KAFKA_PORT}
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:${KAFKA_PORT}
KAFKA_ZOOKEEPER_CONNECT=zookeeper:${ZOOKEEPER_PORT}